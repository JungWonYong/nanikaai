#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "[NanikaAi pre-push] Running Phase 0 pre-test security inspection & automatic behavior check (--mode auto)..."
if command -v python3 >/dev/null 2>&1; then
    python3 "$ROOT_DIR/scripts/verify_behavior.py" --mode auto
else
    python "$ROOT_DIR/scripts/verify_behavior.py" --mode auto
fi
